{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GibFramework": ""
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Jwt": {
    "Audience": "gibframework-api",
    "Issuer": "gibframework",
    "SigningKey": "",
    "DevTokenEnabled": false,
    "AccessTokenMinutes": 60
  },
  "Compliance": {
    "AllowUnapprovedRules": false,
    "SeedPath": "DAL/Seed"
  },
  "Bootstrap": {},
  "Demo": {
    "Enabled": false
  },
  "Security": {
    "DataProtectionKeysPath": "keys"
  },
  "GibPortal": {
    "Enabled": true,
    "AllowProduction": false,
    "ProductionBaseUrl": "https://earsivportal.efatura.gov.tr",
    "TestBaseUrl": "https://earsivportaltest.efatura.gov.tr",
    "RequestTimeoutSeconds": 30,
    "SessionIdleMinutes": 20
  },
  "Swagger": {
    "Enabled": false
  },
  "Locations": {
    "SyncEnabled": false,
    "RequestDelaySeconds": 3,
    "RetryAfterLimitHours": 6
  },
  "TaxOffices": {
    "AutoLoad": false
  },
  "Workflow": {
    "RequireMakerChecker": true,
    "SelfApprovalRoles": [
      "TenantOwner",
      "AccountingManager"
    ]
  },
  "Signing": {
    "Mode": "WindowsStore",
    "Thumbprint": "",
    "StoreLocation": "LocalMachine",
    "ExpiryAlertDays": [
      90,
      60,
      30,
      15,
      7,
      1
    ]
  },
  "EvidenceVault": {
    "RootPath": "evidence"
  },
  "Providers": {
    "Active": "Sandbox",
    "GibDirectEnabled": false,
    "SpecialIntegratorMode": false,
    "RequestTimeoutSeconds": 30,
    "SandboxRegisteredTaxpayers": [],
    "PortalOnly": false
  },
  "Ubl": {
    "SchemaDirectory": "DAL/Gib/UBL-TR",
    "RequireSchemaValidation": false
  },
  "App": {
    "ProductName": "GIB Framework",
    "PublicUrl": "https://framework.hamzadenizyilmaz.com.tr"
  },
  "Messaging": {
    "WorkerEnabled": true,
    "WorkerIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxAttempts": 6,
    "SmtpTimeoutSeconds": 30,
    "NetgsmBaseUrl": "https://api.netgsm.com.tr",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls",
      "UserName": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "GIB Framework",
      "ReplyTo": ""
    },
    "Sms": {
      "UserCode": "",
      "Password": "",
      "Header": ""
    }
  },
  "Workers": {
    "DispatcherEnabled": true,
    "DispatcherIntervalSeconds": 5,
    "ReconciliationEnabled": true,
    "ReconciliationIntervalMinutes": 1,
    "InDoubtGraceMinutes": 5,
    "LegalSourceWatcherEnabled": false,
    "LegalSourceWatcherIntervalHours": 24,
    "CertificateMonitorEnabled": true
  }
}
